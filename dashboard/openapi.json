    "/v1/stats": {
      "get": {
        "summary": "Get Stats",
        "description": "Fleet-wide rollups for the dashboard Overview: run/failure/cost\ncounters, a per-day series, cost split by project, the newest\ndetections across every run, and this window's change against the\none before it.\n\n``days`` restricts to runs started within the last N days (and\ncomputes the deltas against the equally-long window before that);\nomitted means the whole bounded scan with no delta baseline.",
        "operationId": "get_stats_v1_stats_get",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Days"
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
