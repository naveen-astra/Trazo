    "/v1/runs/{run_id}/detections": {
      "get": {
        "summary": "List Detections",
        "description": "Most-recently-raised first (TRZ-P5-06) \u2014 small enough per run\n(rule-detector fires, not every event) that this skips the query\nAPI's cursor pagination entirely, matching the replay-bundle\nendpoint's \"small enough to just return it all\" reasoning below.",
        "operationId": "list_detections_v1_runs__run_id__detections_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
