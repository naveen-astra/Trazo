    "/v1/runs/{run_id}/replay-bundle": {
      "get": {
        "summary": "Get Replay Bundle",
        "description": "NDJSON: line 1 a manifest (run metadata, event count, deduplicated\nblob manifest), then one line per event in seq order \u2014 everything a\nreplay session (SDK.md's ``trazo.replay``) needs, in one document\n(REPLAY_ENGINE.md \u00a77). Immutable/cacheable forever *once a run is no\nlonger ``running``*: a still-running run's bundle would otherwise be\ncached as if complete, which it isn't yet.",
        "operationId": "get_replay_bundle_v1_runs__run_id__replay_bundle_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
