    "/v1/agents": {
      "get": {
        "summary": "List Agents",
        "description": "Per-agent rollup from recent events' ``agent_id``.\n\n``unattributed_events`` is reported alongside on purpose: only an\nadapter that can name the acting agent sets ``agent_id`` (CrewAI's\ndoes, per-role; the LangGraph adapter leaves it null because a graph\nnode isn't an agent identity), so an empty list here means \"nothing\nattributed\", not \"nothing ran\".",
        "operationId": "list_agents_v1_agents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
