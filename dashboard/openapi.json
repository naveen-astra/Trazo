        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/blobs/{sha256}": {
      "get": {
        "summary": "Get Blob",
        "description": "Immutable, cacheable (API_SPEC.md \"Live\"/\"Query\"). Every blob this\ncontrol plane writes is JSON (store_worker.py's offload path always\nencodes offloaded fields as JSON before calling BlobStore.put) \u2014 the\nfilesystem store doesn't track per-blob content_type, so this is a\nfixed value, not a lookup, until the blobs projection table (DATABASE.md\n\u00a72) is actually populated by something.",
        "operationId": "get_blob_v1_blobs__sha256__get",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
