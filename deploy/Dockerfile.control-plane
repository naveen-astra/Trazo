# Control plane image. Build context is the repo root (compose sets it)
# so the schema/ directory is reachable when the contract jobs need it.
FROM python:3.11-slim

WORKDIR /app

COPY control-plane/pyproject.toml control-plane/README.md ./
COPY control-plane/src ./src

RUN pip install --no-cache-dir .

EXPOSE 8420

CMD ["python", "-m", "trazo_server"]
