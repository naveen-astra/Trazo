# Production configuration template. Do not fill this in by hand -- generate
# the real file, with random secrets, by running:
#
#   python scripts/prod/init_env.py --domain trazo.example.com --email ops@example.com
#
# That writes deploy/.env.production (gitignored). The placeholder values
# below are deliberately rejected by the control plane at startup.

TRAZO_DOMAIN=trazo.example.com
ACME_EMAIL=ops@example.com

TRAZO_DASHBOARD_PASSWORD=change-me
TRAZO_SESSION_SECRET=change-me
TRAZO_SESSION_TTL_HOURS=12

TRAZO_API_KEY=dev-change-me

POSTGRES_USER=trazo
POSTGRES_DB=trazo
POSTGRES_PASSWORD=trazo
REDIS_PASSWORD=change-me

HTTP_PORT=80
HTTPS_PORT=443
