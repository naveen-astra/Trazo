# Copy to deploy/.env (gitignored) before `make up`.
# Every TRAZO_* option is documented in ARCHITECTURE §6.

# --- credentials (dev defaults; change for anything non-local) ---
TRAZO_API_KEY=dev-change-me
POSTGRES_USER=trazo
POSTGRES_PASSWORD=trazo
POSTGRES_DB=trazo

# --- host port mapping ---
POSTGRES_PORT=5432
REDIS_PORT=6379
OPA_PORT=8181
CONTROL_PLANE_PORT=8420
DASHBOARD_PORT=5173

# --- optional MinIO profile (docker compose --profile minio up; ADR-010) ---
MINIO_ROOT_USER=trazo
MINIO_ROOT_PASSWORD=trazo-dev-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
