# Dashboard image: static build served by nginx. Build context is dashboard/.
FROM node:20-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Unset (the local stack): the dashboard calls the control plane at
# http://localhost:8420. Set to "" (production): it calls its own origin,
# where the reverse proxy routes /v1 to the control plane -- which is what
# lets the session cookie be SameSite=Strict.
ARG VITE_API_BASE_URL
RUN npm run build

# Runs as an unprivileged user and listens on 8080, so the container needs
# no capabilities at all.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
